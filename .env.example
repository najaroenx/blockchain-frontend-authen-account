# Base URL the browser calls for this app's own /api/* routes.
# Leave unset to use a relative path (same-origin).
NEXT_PUBLIC_API_URL=

# Bypasses OTP verification end-to-end (client + server) for local testing.
# Ignored outside development regardless of this value — see
# app/verifyPhone/PinOTP.tsx and app/api/otp/verify/route.ts.
NEXT_PUBLIC_SKIP_OTP_VERIFICATION=false

# Server-side only: the merchant backend the /api/otp/* routes proxy to.
# TODO: no confirmed value yet — defaults to http://localhost:4000 in code.
MERCHANT_BACKEND=
